# Values are intentionally empty. Fill required settings in the local .env or
# deployment secret store; leave unused optional settings unset, not empty.
# Browser-public flags only. Production API transport is same-origin /api.
VITE_OWNER_PREVIEW=
VITE_WEB_ACCESS_REQUIRED=
VITE_BUILD_COMMIT=
# Legacy public API setting; does not override production /api transport.
VITE_API_BASE=

# Backend only. Never prefix these settings with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=
REDIS_URL=
SESSION_SECRET=
# Legacy alias: set SESSION_SECRET or PROTREBOT_SESSION_SECRET, not both.
PROTREBOT_SESSION_SECRET=
PROTREBOT_WEB_ACCESS_TOKEN=
PROTREBOT_VAULT_MASTER_KEY=
PROTREBOT_WEB_REQUIRE_AUTH=
PROTREBOT_DURABLE_AUTH_REQUIRED=
PROTREBOT_BOOTSTRAP_OWNER_EMAIL=
PROTREBOT_DATA_DIR=

# Local Docker database password, not a frontend setting.
POSTGRES_PASSWORD=

# Backend public frontend URL used in verification and reset links.
APP_BASE_URL=

# Comma-separated exact origins. Never use *.
PROTREBOT_CORS_ORIGINS=

# Gmail API OAuth2 settings. Enter secrets only in the deployment secret store.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=
GMAIL_FROM_NAME=

# Backend payment configuration, required only when billing is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MASTER_MODE_MONTHLY=

# Set true only for isolated local development when you need response tokens.
PROTREBOT_EXPOSE_DEV_TOKENS=

# Per-member Analyst rolling budget (server-side).
ANALYST_DAILY_CREDITS=
ANALYST_COST=
CREDIT_WINDOW_HOURS=
ANALYST_CACHE_MINUTES=

# Read-only customer assistant; keep its API key in the backend secret store.
ASSISTANT_ENABLED=
ASSISTANT_MODEL=
ANTHROPIC_API_KEY=
ASSISTANT_MAX_INPUT_CHARS=
ASSISTANT_HISTORY_MESSAGES=
ASSISTANT_HISTORY_MESSAGE_MAX_CHARS=
ASSISTANT_PAGE_CONTEXT_MAX_CHARS=
ASSISTANT_REQUEST_TIMEOUT_SECONDS=
ASSISTANT_PROTECTION_STALE_SECONDS=
ASSISTANT_PROACTIVE_ENABLED=
ASSISTANT_PROACTIVE_INACTIVE_DAYS=
ASSISTANT_PROACTIVE_COOLDOWN_HOURS=
ASSISTANT_PROACTIVE_POLL_SECONDS=
ASSISTANT_SECRET_MIN_ALPHANUMERIC_CHARS=
ASSISTANT_BUDGET_WARNING_FRACTION=
ASSISTANT_PER_MINUTE_LIMIT=
ASSISTANT_DAILY_LIMIT=
ASSISTANT_MONTHLY_BUDGET_USD=
ASSISTANT_MAX_OUTPUT_TOKENS=
ASSISTANT_MAX_LLM_CALLS_PER_MESSAGE=
ASSISTANT_MAX_TOTAL_INPUT_TOKENS_PER_MESSAGE=
ASSISTANT_MAX_TOTAL_OUTPUT_TOKENS_PER_MESSAGE=
ASSISTANT_CACHE_WRITE_PRICE_USD_PER_MILLION=
ASSISTANT_CACHE_READ_PRICE_USD_PER_MILLION=
ASSISTANT_INPUT_PRICE_USD_PER_MILLION=
ASSISTANT_OUTPUT_PRICE_USD_PER_MILLION=
