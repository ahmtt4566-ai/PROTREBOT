# Frontend public API origin. Do not append /api.
VITE_API_BASE=

# Backend public frontend URL used in verification and reset links.
APP_BASE_URL=

# Comma-separated exact origins. Never use *.
PROTREBOT_CORS_ORIGINS=

# Gmail API OAuth2 settings. Enter secrets only in the deployment secret store.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=privacykais@gmail.com
GMAIL_FROM_NAME=ProTreBot

# Set true only for isolated local development when you need response tokens.
PROTREBOT_EXPOSE_DEV_TOKENS=false

# Per-member Analyst rolling budget (server-side).
ANALYST_DAILY_CREDITS=100
ANALYST_COST=10
CREDIT_WINDOW_HOURS=24
ANALYST_CACHE_MINUTES=15

# Read-only customer assistant; keep its API key in the backend secret store.
ASSISTANT_ENABLED=true
ASSISTANT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
ASSISTANT_MAX_INPUT_CHARS=500
ASSISTANT_HISTORY_MESSAGES=4
ASSISTANT_HISTORY_MESSAGE_MAX_CHARS=2000
ASSISTANT_PAGE_CONTEXT_MAX_CHARS=300
ASSISTANT_REQUEST_TIMEOUT_SECONDS=30
ASSISTANT_PROTECTION_STALE_SECONDS=30
ASSISTANT_PROACTIVE_ENABLED=true
ASSISTANT_PROACTIVE_INACTIVE_DAYS=7
ASSISTANT_PROACTIVE_COOLDOWN_HOURS=24
ASSISTANT_PROACTIVE_POLL_SECONDS=300
ASSISTANT_SECRET_MIN_ALPHANUMERIC_CHARS=40
ASSISTANT_BUDGET_WARNING_FRACTION=0.8
ASSISTANT_PER_MINUTE_LIMIT=6
ASSISTANT_DAILY_LIMIT=20
ASSISTANT_MONTHLY_BUDGET_USD=50
ASSISTANT_MAX_OUTPUT_TOKENS=500
ASSISTANT_MAX_LLM_CALLS_PER_MESSAGE=3
ASSISTANT_MAX_TOTAL_INPUT_TOKENS_PER_MESSAGE=12000
ASSISTANT_MAX_TOTAL_OUTPUT_TOKENS_PER_MESSAGE=1500
ASSISTANT_CACHE_WRITE_PRICE_USD_PER_MILLION=1.25
ASSISTANT_CACHE_READ_PRICE_USD_PER_MILLION=0.10
ASSISTANT_INPUT_PRICE_USD_PER_MILLION=1
ASSISTANT_OUTPUT_PRICE_USD_PER_MILLION=5
