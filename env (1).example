# Yalnızca https://demo.binance.com üzerinden üretilen Futures Demo anahtarları.
# Gerçek Binance anahtarlarını bu projede kullanmayın.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET_KEY=

# V27 Web — GitHub'a gerçek değerleri değil yalnızca bu örneği gönderin.
DATABASE_URL=postgresql://protrebot:change-me@127.0.0.1:5432/protrebot
REDIS_URL=redis://127.0.0.1:6379/0
PROTREBOT_WEB_REQUIRE_AUTH=false
PROTREBOT_WEB_ACCESS_TOKEN=
PROTREBOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROTREBOT_DATA_DIR=
PROTREBOT_EXECUTION_MODE=TESTNET_FIRST
PROTREBOT_PAPER_ENABLED=false
PROTREBOT_LIVE_CHANNEL_ENABLED=true
PROTREBOT_DEPLOYMENT_TIER=FREE_PREVIEW
PROTREBOT_MIN_CONFIDENCE=80
# false: 1h ve 4h ikisi de eşleşmeli; true: 1h veya 4h eşleşmesi yeterli.
PROTREBOT_MTF_ALLOW_EITHER_TIMEFRAME=false

# İlk yayında boş bırakın. Canlı kanal ayrı güvenlik kapıları tamamlanmadan açılmaz.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_SECRET_KEY=
